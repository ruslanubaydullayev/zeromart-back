# From @BotFather
BOT_TOKEN=123456:ABC-DEF

# Comma-separated Telegram user IDs (numeric)
ADMIN_IDS=123456789,987654321

# Channel @username or -100xxxxxxxxxx (bot must be admin with post rights)
CHANNEL_ID=@your_market_channel

# Optional
DATABASE_PATH=zeromart.db
MAX_ADS_PER_HOUR=5

